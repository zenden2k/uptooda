    implicitHeight: 1
    width: parent ? parent.width : implicitWidth
    height: 1
    padding: 0
    horizontalPadding: 0
    verticalPadding: 0
    leftPadding: 0
    rightPadding: 0
    topPadding: 0
    bottomPadding: 0
    leftInset: 0
    rightInset: 0
    topInset: 0
    bottomInset: 0

    contentItem: Rectangle {
        implicitHeight: 1
        color: "#e6ebf0"
    }
}
