QWidget {
    color: #263548;
    font-size: 13px;
}
QMainWindow, QDialog {
    background: #f3f7fa;
}
QDialog#settingsDialog {
    background: #f3f7fa;
}
QListWidget#settingsPageList {
    color: #526273;
    background: #e9f0f5;
    border: 0;
    border-right: 1px solid #d8e1e9;
    outline: 0;
    padding: 18px 10px;
}
QListWidget#settingsPageList::item {
    min-height: 42px;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 13px;
}
QListWidget#settingsPageList::item:hover {
    color: #205574;
    background: #edf6fc;
}
QListWidget#settingsPageList::item:selected {
    color: #1f78b4;
    background: #ffffff;
    border-color: #c9e3f3;
}
QStackedWidget#settingsPageStack {
    background: #f3f7fa;
}
QLabel#settingsPageTitle {
    color: #24354a;
    font-size: 21px;
    font-weight: 600;
}
QLabel#settingsHint {
    color: #718096;
    font-size: 12px;
}
QFrame#settingsFooter {
    background: #f9fbfd;
    border-top: 1px solid #dce5ec;
}
QLabel#settingsSavedLabel {
    color: #25835a;
}
QPushButton#settingsOkButton {
    color: #ffffff;
    background: #2789c9;
    border-color: #1f78b4;
    padding-left: 20px;
    padding-right: 20px;
}
QPushButton#settingsOkButton:hover {
    background: #1f7fbe;
}
QPushButton#settingsOkButton:pressed {
    background: #196fa9;
}
QPushButton#destructiveSettingsButton {
    color: #9b3c47;
    background: #fff1f2;
    border-color: #efc0c5;
}
QPushButton#destructiveSettingsButton:hover {
    background: #ffe2e5;
}
QMenuBar {
    background: #e9edf2;
    border: 1px solid #d7dde5;
    padding: 3px 8px;
    spacing: 1px;
}
QMenuBar::item {
    color: #263548;
    background: transparent;
    border-radius: 6px;
    padding: 8px 11px;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background: #d9e1e9;
}
QMenu {
    background: transparent;
    border: 0;
    padding: 0;
}
QMenu::item {
    color: #263548;
    padding: 6px 10px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #e7f3fb;
}
QMenu::item:disabled {
    color: #9aa5b2;
}
QMenu::separator {
    height: 1px;
    background: #e6ebf0;
    margin: 2px 0;
}
QToolBar {
    background-color: #f9fbfd;
    border: 1px solid #e1e7ee;
    spacing: 0;
    padding: 5px 5px 5px 5px;
}
QWidget#tabSwitcher {
    background-color: #ffffff;
    border: 1px solid #e2e8ef;
}
QTabBar {
    background: transparent;
    border: 0;
    padding: 0;
}
QTabBar::tab {
    color: #5b697b;
    background: transparent;
    border: 0;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    min-height: 38px;
    padding: 0 18px;
    margin-right: 8px;
}
QTabBar::tab:hover {
    background: #edf6fc;
}
QTabBar::tab:selected {
    color: #2789c9;
    background: transparent;
    border-bottom-color: #55afe8;
}
QToolBar#mainToolBar QToolButton {
    color: #205574;
    background: #c5eafd;
    border: 1px solid #9fd3ef;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 400;
    min-height: 28px;
    padding: 3px 7px;
}
QToolBar#mainToolBar QToolButton:hover {
    background: #a9def8;
}
QToolBar#mainToolBar QToolButton:pressed {
    background: #75bce7;
}
QToolBar#mainToolBar QToolButton:disabled {
    color: #8b96a3;
    background: #e5e9ed;
    border-color: #cbd2d9;
}
QPushButton, QToolButton {
    color: #315e7b;
    background: #eaf6ff;
    border: 1px solid #afd7f3;
    border-radius: 8px;
    min-height: 30px;
    padding: 2px 9px;
}
QPushButton:hover, QToolButton:hover {
    background: #d9efff;
}
QPushButton:pressed, QToolButton:pressed {
    background: #cce8fa;
}
QPushButton:disabled, QToolButton:disabled {
    color: #8a98a7;
    background: #eef2f6;
    border-color: #d5dee7;
}
QPushButton.highlighted {
    color: #ffffff;
    background: #2789c9;
    border-color: #1f78b4;
    padding-left: 20px;
    padding-right: 20px;
}
QPushButton#grabButton:hover {
    background: #1f7fbe;
    border-color: #196da4;
}
QPushButton#grabButton:pressed {
    background: #196fa9;
    border-color: #155e90;
}
QPushButton#grabButton:disabled {
    color: #e7edf2;
    background: #93b7ce;
    border-color: #86a9bf;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    color: #1f2c3d;
    background: #f1f6fb;
    border: 1px solid #c6d5e3;
    border-radius: 8px;
    min-height: 32px;
    selection-background-color: #9fd5f6;
    selection-color: #1f2c3d;
}
QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 0 10px;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover,
QComboBox:hover, QSpinBox:hover {
    background: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus {
    border-color: #65aee8;
    background: #ffffff;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QComboBox:disabled, QSpinBox:disabled {
    color: #8794a3;
    background: #eef2f6;
}
QComboBox {
    padding: 0 38px 0 11px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 34px;
    border: 0;
}
QComboBox::down-arrow {
    image: url(:/res/chevron-down.svg);
    width: 14px;
    height: 9px;
}
QToolButton#serverAccountButton {
    color: #1f2c3d;
    background: #f1f6fb;
    border: 1px solid #c6d5e3;
    border-radius: 8px;
    min-height: 38px;
    padding: 0 41px 0 11px;
    text-align: left;
}
QToolButton#serverAccountButton:hover {
    background: #ffffff;
}
QToolButton#serverAccountButton:pressed {
    background: #e5f3ff;
}
QToolButton#serverAccountButton::menu-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    right: 1px;
    width: 34px;
    height: 38px;
    border: 0;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QToolButton#serverAccountButton::menu-button:hover {
    background: #e1f2fd;
}
QToolButton#serverAccountButton::menu-button:pressed,
QToolButton#serverAccountButton::menu-button:open {
    background: #cce8fa;
}
QToolButton#serverAccountButton::menu-arrow {
    image: url(:/res/chevron-down.svg);
    width: 14px;
    height: 9px;
}
QToolButton#cancelMosaicButton {
    background: #fff1f2;
    border: 1px solid #efc0c5;
    border-radius: 8px;
    min-height: 26px;
    padding: 0;
}
QToolButton#cancelMosaicButton:hover {
    background: #ffe2e5;
    border-color: #dfa1a8;
}
QToolButton#cancelMosaicButton:pressed {
    background: #fbd2d6;
    border-color: #cf838c;
}
QToolButton#cancelMosaicButton:disabled {
    background: #f5f0f1;
    border-color: #e1d6d8;
}
QAbstractItemView#comboBoxPopupView {
    color: #24354a;
    background: transparent;
    border: 0;
    padding: 0;
    outline: 0;
}
QAbstractItemView#comboBoxPopupView::item {
    color: #24354a;
    background: transparent;
    border: 0;
    border-radius: 4px;
    padding: 0;
}
QAbstractItemView#comboBoxPopupView::item:selected,
QAbstractItemView#comboBoxPopupView::item:hover {
    color: #24354a;
    background: transparent;
}
QSpinBox {
    padding: 0 61px 0 9px;
}
QSpinBox#numOfFramesSpinBox {
    qproperty-alignment: AlignLeft;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    right: 30px;
    width: 30px;
    height: 38px;
    border: 0;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    right: 1px;
    width: 29px;
    height: 38px;
    border: 0;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}
QSpinBox::down-button:hover, QSpinBox::up-button:hover {
    background: #e1f2fd;
}
QSpinBox::down-button:pressed, QSpinBox::up-button:pressed {
    background: #cce8fa;
}
QSpinBox::down-arrow {
    image: url(:/res/spin-minus.svg);
    width: 13px;
    height: 13px;
}
QSpinBox::up-arrow {
    image: url(:/res/spin-plus.svg);
    width: 13px;
    height: 13px;
}
QGroupBox {
    color: #526273;
    border: 1px solid #d5e0e9;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
}
QCheckBox, QRadioButton {
    color: #33465b;
    spacing: 7px;
    min-height: 18px;
    padding: 1px 0;
}
QCheckBox:hover, QRadioButton:hover {
    color: #205f88;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #8a98a7;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background: #f8fbfd;
    border: 1px solid #9fb3c5;
}
QCheckBox::indicator {
    border-radius: 4px;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    background: #ffffff;
    border-color: #55afe8;
}
QCheckBox::indicator:pressed, QRadioButton::indicator:pressed {
    background: #d9efff;
    border-color: #2789c9;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked,
QCheckBox::indicator:indeterminate {
    background: #55afe8;
    border-color: #2789c9;
}
QCheckBox::indicator:checked {
    image: url(:/res/checkbox-check.svg);
}
QCheckBox::indicator:indeterminate {
    image: url(:/res/checkbox-indeterminate.svg);
}
QRadioButton::indicator:checked {
    image: url(:/res/radio-dot.svg);
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: #edf1f5;
    border-color: #cbd5df;
}
QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled,
QCheckBox::indicator:indeterminate:disabled {
    background: #aab7c4;
    border-color: #98a6b4;
}
QDialogButtonBox QPushButton {
    min-width: 82px;
}
QProgressBar {
    color: #3f566d;
    background: #dfe8ef;
    border: 0;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background: #55afe8;
    border-radius: 4px;
}
QScrollBar:vertical {
    background: transparent;
    border: 0;
    width: 14px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #b7c7d5;
    border: 0;
    border-radius: 4px;
    margin: 2px 3px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #91a9bc;
}
QScrollBar#comboBoxPopupScrollBar:vertical {
    background: transparent;
    border: 0;
    width: 14px;
    margin: 0;
}
QScrollBar#comboBoxPopupScrollBar::handle:vertical {
    background-color: #b7c7d5;
    border: 0;
    border-radius: 4px;
    min-height: 28px;
    margin: 2px 3px;
}
QScrollBar#comboBoxPopupScrollBar::handle:vertical:hover {
    background-color: #91a9bc;
}
QScrollBar#comboBoxPopupScrollBar::add-line:vertical,
QScrollBar#comboBoxPopupScrollBar::sub-line:vertical,
QScrollBar#comboBoxPopupScrollBar::add-page:vertical,
QScrollBar#comboBoxPopupScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
    border: 0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
    border: 0;
}
QScrollBar:horizontal {
    background: transparent;
    border: 0;
    height: 14px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #b7c7d5;
    border: 0;
    border-radius: 4px;
    margin: 3px 2px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover {
    background: #91a9bc;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0;
    background: transparent;
    border: 0;
}
QStatusBar {
    color: #607086;
    background: #f9fbfd;
    border-top: 1px solid #e1e7ee;
}

QDialog#serverListPopup {
    background: transparent;
    border: 0;
}
QDialog#serverListPopup QRadioButton {
    padding: 3px 4px;
}
QLineEdit#serverSearchEdit {
    min-height: 36px;
    background: #ffffff;
    border-color: #c6d5e3;
}
QLineEdit#serverSearchEdit:hover {
    border-color: #a9bfd2;
}
QLineEdit#serverSearchEdit:focus {
    border-color: #55afe8;
}
QLineEdit#serverSearchEdit QToolButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
}
QLineEdit#serverSearchEdit QToolButton:hover,
QLineEdit#serverSearchEdit QToolButton:pressed {
    background: transparent;
}
QToolButton#serverOptionsButton {
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    padding: 0;
    background: #f1f6fb;
    border-color: #c6d5e3;
}
QToolButton#serverOptionsButton:hover {
    background: #ffffff;
    border-color: #a9bfd2;
}
QToolButton#serverOptionsButton:pressed {
    background: #dff1fc;
    border-color: #65aee8;
}
QTableView#serverTable {
    color: #263548;
    background: #ffffff;
    alternate-background-color: #f8fbfd;
    border: 1px solid #d5e0e9;
    border-radius: 9px;
    gridline-color: #edf2f6;
    outline: 0;
    selection-background-color: #e5f3ff;
    selection-color: #205574;
}
QTableView#serverTable::item {
    border: 0;
    border-bottom: 1px solid #edf2f6;
    padding: 7px 9px;
}
QTableView#serverTable::item:hover {
    background: #edf6fc;
}
QTableView#serverTable::item:selected {
    color: #205574;
    background: #dff1fc;
}
QTableView#serverTable QHeaderView {
    background: #edf4f9;
}
QTableView#serverTable QHeaderView::section {
    color: #526273;
    background: #edf4f9;
    border: 0;
    border-right: 1px solid #dbe5ed;
    border-bottom: 1px solid #d5e0e9;
    min-height: 34px;
    padding: 3px 9px;
    font-weight: 600;
}
QTableView#serverTable QTableCornerButton::section {
    background: #edf4f9;
    border: 0;
    border-bottom: 1px solid #d5e0e9;
}
QListView#serverIconView {
    color: #263548;
    background: #ffffff;
    border: 1px solid #d5e0e9;
    border-radius: 9px;
    outline: 0;
    padding: 8px;
    selection-background-color: #dff1fc;
    selection-color: #205574;
}
QListView#serverIconView::item {
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px;
}
QListView#serverIconView::item:hover {
    background: #edf6fc;
    border-color: #d9e8f2;
}
QListView#serverIconView::item:selected {
    color: #205574;
    background: #dff1fc;
    border-color: #9fd3ef;
}

QTreeWidget#serverFolderTree {
    color: #263548;
    background: #ffffff;
    alternate-background-color: #f8fbfd;
    show-decoration-selected: 1;
    border: 1px solid #d5e0e9;
    border-radius: 9px;
    outline: 0;
    padding: 6px;
    selection-background-color: #dff1fc;
    selection-color: #205574;
}
QTreeWidget#serverFolderTree::item {
    min-height: 28px;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px 6px;
}
QTreeWidget#serverFolderTree::item:hover {
    color: #205574;
    background: #edf6fc;
    border-color: transparent;
    border-radius: 0;
}
QTreeWidget#serverFolderTree::item:selected {
    color: #205574;
    background: #dff1fc;
    border-color: transparent;
    border-radius: 0;
}
QTreeWidget#serverFolderTree::item:disabled {
    color: #8794a3;
}
QTreeWidget#serverFolderTree::branch {
    background: transparent;
}
QTreeWidget#serverFolderTree::branch:hover {
    background: #edf6fc;
}
QTreeWidget#serverFolderTree::branch:selected,
QTreeWidget#serverFolderTree::branch:selected:active,
QTreeWidget#serverFolderTree::branch:selected:!active {
    background: #dff1fc;
}
QTreeWidget#serverFolderTree::branch:has-children:closed {
    image: url(:/res/tree-branch-closed.svg);
}
QTreeWidget#serverFolderTree::branch:has-children:open {
    image: url(:/res/tree-branch-open.svg);
}
